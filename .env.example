# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# The old configs/groq_token.txt approach is gone â€” secrets in text files are one
# `git add -f` away from disclosure.
#
# NOTE ON FORMAT: keep comments on their own lines, never after a value.
# dotenv strips a trailing `# ...` when a value is present, but on an EMPTY value
# it parses the comment text AS the value â€” which produced a confusing
# "model not available: '# M5 â€” image OCR'" error at startup.

# â”€â”€ Required â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GROQ_API_KEY=

# â”€â”€ Optional â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# M4 web-search fallback
# M4 web search fallback. Free tier is 1,000 searches/month.
# Get one at https://app.tavily.com â€” without it the system still works, it
# just abstains where it would otherwise have searched the web.
TAVILY_API_KEY=
# Set false to force index-only behaviour (also: serve.cli --no-web)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_K=6
# "basic" costs 1 Tavily credit per call, "advanced" costs 2 and returns more text
WEB_SEARCH_DEPTH=advanced
# Tracing. Also set LANGSMITH_TRACING=true to actually emit traces.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=verifai

# â”€â”€ Groq models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Groq deprecates and renames models on a rolling basis. core/llm.py checks
# these against GET /openai/v1/models at startup and fails loudly on a miss, so
# a rename surfaces as a clear boot error instead of a mid-request 404.
GROQ_MODEL=openai/gpt-oss-120b

# M5 â€” speech to text
GROQ_WHISPER_MODEL=whisper-large-v3

# M5 â€” image OCR. Leave EMPTY until M5; an unset model is skipped by the check.
# Populate from `python -m core.llm --list` once you pick one.
GROQ_VISION_MODEL=

# â”€â”€ Retrieval â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
INDEX_PATH=index/current

# Must match the index manifest, or Tier 2 refuses to boot.
EMBED_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# 700 chars ~= 180 tokens â€” comfortably inside MiniLM's 256-token cap.
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Candidates per retriever before fusion; TOP_K is what survives reranking.
CANDIDATE_K=20
TOP_K=8

# Evidence below this cross-encoder score is dropped. If nothing survives, the
# graph abstains rather than inventing an analysis of irrelevant documents.
# Calibrated, not guessed. Swept at M3 against a 200-query known-item set and a
# 20-claim adversarial set: python -m eval_harness.run_eval --sweep
# Retains 99.5% of gold documents, abstains on 80% of unanswerable claims.
RELEVANCE_FLOOR=0.25

# â”€â”€ Trained models (yours â€” local, CPU) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CLAIM_DETECTOR_PATH=models/claim_detector/final
STANCE_DETECTOR_PATH=models/stance_detector/final

# "cpu", or a CUDA device index like 0
DEVICE=cpu
