# ============================================
# EXCLUDE ALL LARGE FILES (>5MB)
# ============================================

# Model directories (contains large .safetensors files ~400MB each)
models/claim_detector/final/
models/stance_detector/final/
models/ner_model/final/
models/llm_finetuned/final/

# Keep only README files in model directories
!models/*/README.md
!models/README.md

# Data directories (contains large CSV/JSON files)
data/raw/
data/processed/
data/chroma_db/

# Keep only README files in data directories  
!data/README.md
!data/*/README.md

# Test model files (125MB FastText model)
tests/models/language_detection/*.bin

# Keep README in test models
!tests/models/*/README.md

# Large file extensions
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.pickle

# Large data files
*.csv
*.jsonl
*.json
*.sqlite3
*.db
*.parquet

# Archive files
*.zip
*.tar.gz
*.7z
*.rar

# Media files
*.mp4
*.avi
*.mov
*.wav
*.mp3
*.flac
*.png
*.jpg
*.jpeg
*.gif
*.tiff
*.bmp

# Notebook checkpoints
.ipynb_checkpoints/

# Large text files
*.txt
!requirements.txt
!*.md
# ============================================
# VerifAI v2 (rebuild/two-tier)
# ============================================

# Secrets — never commit. .env.example is the tracked template.
.env
.env.*
!.env.example

# THE CONTRACT — Tier 1 build output, rebuildable in ~2 minutes
index/

# Embedding cache (CacheBackedEmbeddings)
data/.embed_cache/

# Packaging
*.egg-info/
.pytest_cache/

# ── M3 eval artifacts: these ARE the deliverable ──────────────────────────
# The blanket *.json / *.jsonl rules above exist for bulk data dumps, but the
# eval datasets and results must be in the repo — the README quotes these
# numbers, and a metric nobody can reproduce is not a metric.
!eval_harness/datasets/
!eval_harness/datasets/*.jsonl
!eval_harness/results/
!eval_harness/results/*.json
!eval_harness/results/*.md

# Cleanup staging area (scripts/cleanup.py). Holds removed files until the repo
# is verified; delete the directory by hand once you are happy.
_trash/

# Generated report exports (html/docx/mp3 written by serve.nodes.export).
data/outputs/

# --- React frontend ---------------------------------------------------------
frontend/node_modules/
ui/dist/
# The blanket *.json rule above would swallow the manifest and lockfile, which
# are the two files a clone actually needs to reproduce the frontend build.
!frontend/package.json
!frontend/package-lock.json

# --- Test fixtures ARE committed -------------------------------------------
# The blanket image/audio rules above would swallow them, but the demo's voice
# and image scenarios and several tests need these files on a clean clone.
# ~190 KB total, and regenerable with `python -m tests.make_fixtures`.
!tests/fixtures/
!tests/fixtures/*.mp3
!tests/fixtures/*.png
!tests/fixtures/*.docx
!tests/fixtures/*.pdf
